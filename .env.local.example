# Uribcare platform environment
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only: full-access key. Used for the username -> email lookup and other
# trusted server actions. NEVER expose this to the browser or prefix it with
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The site's own origin, used to build password-reset callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
